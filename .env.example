# ============================================================================
# PLACEMENT CRM API — Environment Variables Template
# ============================================================================
# Copy this file as .env and fill in your values.
# All variables marked [REQUIRED] must be set before starting the server.
# ============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Authentication [REQUIRED] ---
SYSADMIN_EMAIL=
SYSADMIN_PASSWORD=

# --- JWT [REQUIRED] ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Database [REQUIRED] ---
# Supabase pooler (port 6543) or direct connection (port 5432)
DATABASE_URL=

# --- DB Pool Tuning ---
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# --- Logging ---
# Levels: error, warn, info, debug
LOG_LEVEL=info
LOG_DIR=./logs

# --- CORS ---
# Comma-separated origins. Use * for development only.
# Production example: https://placenex.in,https://*.placenex.in
FRONTEND_URL=*

# --- Email / SMTP (required in production for password reset) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PlaceNex" <noreply@placenex.in>
