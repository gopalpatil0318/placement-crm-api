## ⚙️ Common Patterns (Implemented)

### Async Handler Wrapper
```js
// utils/asyncHandler.js
const asyncHandler = (fn) => (req, res, next) =>
  Promise.resolve(fn(req, res, next)).catch(next);

// Usage in routes:
router.post('/login', authLimiter, validate(schema), asyncHandler(controller.login));
// All async errors automatically forwarded to errorHandler middleware
```

### Middleware Chain Examples
```js
// Public auth endpoint (login, forgot/reset password):
router.post('/login', authLimiter, validate(loginSchema), asyncHandler(controller.login));

// Authenticated read:
router.get('/profile', authenticate, asyncHandler(controller.getProfile));

// Authenticated write:
router.post('/apply', authenticate, apiLimiter, validate(schema), asyncHandler(controller.apply));

// Role-restricted write (COLLEGEADMIN only):
router.post('/create_user',
  authenticate,
  requireRole(ROLES.COLLEGEADMIN),
  apiLimiter,
  validate(createUserSchema),
  asyncHandler(controller.createUser)
);
```

### DB Query Patterns
```js
// Simple query (utils/db.js):
const result = await query('SELECT * FROM students WHERE college_id = $1', [collegeId]);

// Transaction:
const client = await getClient();
try {
  await client.query('BEGIN');
  const r1 = await client.query('INSERT INTO ...', [...]);
  await client.query('UPDATE ...', [...]);
  await client.query('COMMIT');
  return r1.rows[0];
} catch (err) {
  await client.query('ROLLBACK');
  throw err;
} finally {
  client.release();
}

// Parallel independent queries:
const [jobResult, studentResult, criteriaResult] = await Promise.all([
  query('SELECT * FROM job_postings WHERE job_id = $1', [jobId]),
  query('SELECT * FROM students WHERE student_id = $1', [studentId]),
  query('SELECT * FROM job_eligibility_criteria WHERE job_id = $1', [jobId]),
]);
```

### Dynamic WHERE Builder
```js
// Pattern used in all list/filter endpoints:
const conditions = ['s.college_id = $1'];
const params = [collegeId];
let idx = 2;

if (filters.dept_id) { conditions.push(`s.dept_id = $${idx++}`); params.push(filters.dept_id); }
if (filters.status)  { conditions.push(`s.student_status = $${idx++}`); params.push(filters.status); }

const where = conditions.join(' AND ');
const sql = `SELECT * FROM students s WHERE ${where} ORDER BY s.first_name ASC LIMIT $${idx} OFFSET $${idx+1}`;
params.push(pagination.limit, pagination.offset);
```

### Pagination Helper
```js
// utils/pagination.js
function getPagination(filters) {
  const page = Math.max(1, parseInt(filters.page) || 1);
  const limit = Math.min(Math.max(1, parseInt(filters.limit) || 10), 100);
  const offset = (page - 1) * limit;
  return { page, limit, offset };
}

// In controller (using sendPaginated):
const { rows: data, rowCount } = await query(countSql + dataSql, params);
return sendPaginated(res, data, total, { page, limit }, 'Retrieved successfully');
```

### Sort Column Whitelist
```js
// Prevent ORDER BY injection by whitelisting allowed sort columns:
const ALLOWED_SORT = ['first_name', 'last_name', 'created_at', 'student_passout_year'];
const sortCol = ALLOWED_SORT.includes(filters.sort_by) ? filters.sort_by : 'created_at';
const sortDir = filters.sort_order === 'asc' ? 'ASC' : 'DESC';
const sql = `... ORDER BY s.${sortCol} ${sortDir}`;
```

